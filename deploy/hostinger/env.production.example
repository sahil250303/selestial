# ==============================================================================
# Selestial - Production Environment Variables (Hostinger)
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=production

# Domain & CORS (CRITICAL: Replace with your actual Hostinger domain)
# ALLOWED_ORIGIN supports comma-separated domains
SITE_URL=https://yourdomain.com
ALLOWED_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Authentication (CRITICAL)
# Generate a strong 64+ char random string for JWT_SECRET
JWT_SECRET=replace-with-a-secure-random-64-character-jwt-secret
# Admin password for username 'admin' (Change from default!)
ADMIN_PASSWORD=ReplaceWithStrongAdminPassword123!

# Database Configuration (SQLite)
# Default path relative to project root or specify absolute path
SQLITE_DB_PATH=./server/database.sqlite

# Optional: Turso Cloud SQLite (If you prefer remote cloud database)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional: Order Notification Emails (Nodemailer SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=orders@yourdomain.com
SMTP_PASS=your-hostinger-email-password
ADMIN_EMAIL=admin@yourdomain.com
STORE_NAME=Selestial

# Optional: OTP SMS Verification (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional: Stripe Online Payments
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional: Google OAuth
VITE_GOOGLE_CLIENT_ID=


