# ═══════════════════════════════════════════════════════════════════
# SELESTIAL — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit your .env file — it is excluded by .gitignore.
# ═══════════════════════════════════════════════════════════════════

# ── REQUIRED: JWT Secret ─────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-64-char-random-hex-string

# ── REQUIRED: Admin password ──────────────────────────────────────────────────
ADMIN_PASSWORD=replace-with-strong-password

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# Single canonical domain used for SEO (canonical/OG/sitemap). Keep both in sync.
SITE_URL=https://yourdomain.com
VITE_SITE_URL=https://yourdomain.com
# Comma-separated CORS allow-list (no wildcard).
ALLOWED_ORIGIN=https://yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
# STRONGLY RECOMMENDED on serverless (Vercel): the bundled node:sqlite lives in an
# ephemeral /tmp and is wiped on every cold start. Use a durable libSQL/Turso DB.
# Create one free at turso.tech, then:
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
# Local fallback (no Turso): defaults to ./server/database.sqlite
# SQLITE_DB_PATH=./server/database.sqlite

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Gmail: use an App Password (myaccount.google.com/apppasswords), not your login password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
ADMIN_EMAIL=your-personal-email@gmail.com
STORE_NAME=Selestial

# ── Stripe (required for live card payments) ──────────────────────────────────
# Sign up at stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# ── Google OAuth (required for real Google sign-in) ───────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → Create OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Twilio (optional — enables real OTP SMS) ──────────────────────────────────
# Sign up at twilio.com → Console → Account Info
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── Vercel Blob (auto-configured by Vercel CLI — do not edit manually) ─────────
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ── Security tuning (all optional — sensible defaults apply) ──────────────────
# Reverse-proxy hops to trust for client IPs (Vercel defaults to 1 automatically).
# TRUST_PROXY=1
# JSON body size cap for API requests.
# JSON_BODY_LIMIT=100kb
# Minimum password length enforced at signup.
# PASSWORD_MIN_LENGTH=8

# Per-IP rate limits (window in ms + max requests per window).
# Strict tier — credential endpoints:
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_OTP_SEND_WINDOW_MS=600000
# RATE_LIMIT_OTP_SEND_MAX=5
# RATE_LIMIT_OTP_VERIFY_WINDOW_MS=600000
# RATE_LIMIT_OTP_VERIFY_MAX=10
# Moderate tier — anonymous/public API traffic:
# RATE_LIMIT_PUBLIC_WINDOW_MS=900000
# RATE_LIMIT_PUBLIC_MAX=300
# Loose tier — authenticated users & admin dashboard:
# RATE_LIMIT_AUTHED_WINDOW_MS=900000
# RATE_LIMIT_AUTHED_MAX=1000
# Sensitive side-effect routes:
# RATE_LIMIT_CHECKOUT_WINDOW_MS=60000
# RATE_LIMIT_CHECKOUT_MAX=5
# RATE_LIMIT_NEWSLETTER_WINDOW_MS=3600000
# RATE_LIMIT_NEWSLETTER_MAX=5
# RATE_LIMIT_REVIEW_WINDOW_MS=3600000
# RATE_LIMIT_REVIEW_MAX=10
# RATE_LIMIT_UPLOAD_WINDOW_MS=3600000
# RATE_LIMIT_UPLOAD_MAX=60

# Per-account exponential backoff on auth failures (no hard lockout):
# free attempts before delays start, first delay, delay cap, counter reset age.
# AUTH_BACKOFF_FREE_ATTEMPTS=5
# AUTH_BACKOFF_BASE_MS=2000
# AUTH_BACKOFF_MAX_MS=900000
# AUTH_BACKOFF_RESET_MS=3600000

# Upload constraints:
# UPLOAD_MAX_FILES=10
# UPLOAD_MAX_FILE_SIZE_BYTES=10485760
