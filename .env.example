# === REQUIRED IN PRODUCTION ===
# The server refuses to boot in production when these are missing or weak.
# Generate JWT_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-at-least-32-random-chars
# Must be at least 12 characters. The admin user is (re)seeded from this on boot.
ADMIN_PASSWORD=change-me-to-a-strong-password
# Force strong-secret enforcement even outside production/Vercel (recommended).
REQUIRE_STRONG_SECRETS=true

# === STORAGE ===
SQLITE_DB_PATH=./server/database.sqlite
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# === SMTP EMAIL ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
ADMIN_EMAIL=your-personal-email@gmail.com
STORE_NAME=Selestial

# === SMS / OTP (optional) ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# === RATE LIMITING (all thresholds are optional; defaults shown) ===
# Window applied to every limiter (ms).
RATE_LIMIT_WINDOW_MS=900000
# Auth endpoints: per-IP and per-account combined limits with exponential backoff via rate-limit's built-in memory store.
RATE_LIMIT_AUTH_IP_MAX=20
RATE_LIMIT_AUTH_ACCOUNT_MAX=10
# OTP endpoints have tighter limits than password auth.
RATE_LIMIT_OTP_IP_MAX=8
RATE_LIMIT_OTP_ACCOUNT_MAX=5
# Public GETs.
RATE_LIMIT_PUBLIC_MAX=300
# Authenticated user actions.
RATE_LIMIT_AUTHED_MAX=600
# Checkout — public-writable, but heavier weight than a regular GET.
RATE_LIMIT_CHECKOUT_IP_MAX=30

# === FILE UPLOAD ===
# Max size per file. Accepts "5mb", "1gb", or a raw byte count.
UPLOAD_MAX_FILE_BYTES=5mb
UPLOAD_MAX_FILES=10
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/gif

# === ERROR RESPONSES ===
# When false (default), API responses only include a generic error message and a correlation id.
# Server logs contain the full detail keyed by that id.
EXPOSE_ERROR_DETAILS=false
